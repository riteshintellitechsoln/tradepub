# =========================================
# DATABASE
# =========================================
DATABASE_URL="postgresql://user:password@localhost:5432/tradehub?schema=public"

# Used only by prisma/seed.ts to create the first Super Admin.
# Change these before seeding a real/staging/production database.
SEED_ADMIN_EMAIL="admin@tradehub.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"

# =========================================
# NEXTAUTH
# =========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# =========================================
# RESEND (Transactional Email)
# =========================================
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="TradeHub <downloads@yourdomain.com>"

# =========================================
# CLOUDINARY (Book Cover Images)
# =========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =========================================
# CLOUDFLARE R2 (PDF Storage) — S3-compatible
# =========================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="tradehub-ebooks"
R2_PUBLIC_URL=""
R2_ENDPOINT=""

# =========================================
# SECURE DOWNLOAD TOKENS
# =========================================
DOWNLOAD_TOKEN_SECRET="generate-with-openssl-rand-base64-32"
DOWNLOAD_TOKEN_TTL_MINUTES="30"

# =========================================
# RATE LIMITING (Upstash Redis)
# =========================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =========================================
# CRON (Vercel Cron -> /api/cron/expire-downloads)
# =========================================
# Vercel automatically sends this as a Bearer token to your cron routes
# once it's set here — see vercel.json for the schedule.
CRON_SECRET="generate-with-openssl-rand-base64-32"

# =========================================
# APP
# =========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Set to "false" only for the production seed run — keeps categories and
# the admin account, skips the demo publishers/books. See prisma/seed.ts.
SEED_SAMPLE_DATA="true"
